<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application>
        <activity
            android:name="io.github.khaledbahaaeldin.emberbyte.lens.spike.LensSpikeActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <receiver
            android:name="io.github.khaledbahaaeldin.emberbyte.lens.spike.LensSpikeReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="io.github.khaledbahaaeldin.emberbyte.debug.LENS_START" />
                <action android:name="io.github.khaledbahaaeldin.emberbyte.debug.LENS_STOP" />
                <action android:name="io.github.khaledbahaaeldin.emberbyte.debug.LENS_DUMP" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
